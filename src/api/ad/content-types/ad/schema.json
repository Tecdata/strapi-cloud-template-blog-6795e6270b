{
  "kind": "collectionType",
  "collectionName": "ads",
  "info": {
    "singularName": "ad",
    "pluralName": "ads",
    "displayName": "Ad"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "placementKey": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "start_splash_banner",
        "home_following_banner",
        "home_news_banner",
        "athlete_profile_banner",
        "team_profile_banner",
        "team_fixture_banner",
        "team_formation_banner",
        "between_matches_banner"
      ]
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "priority": {
      "type": "integer",
      "required": true,
      "default": 50,
      "min": 1,
      "max": 100
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "clickUrl": {
      "type": "string"
    },
    "startAt": {
      "type": "datetime"
    },
    "endAt": {
      "type": "datetime"
    },
    "bannerHeight": {
      "type": "enumeration",
      "enum": [
        "s",
        "m",
        "l",
        "xl"
      ]
    }
  }
}
