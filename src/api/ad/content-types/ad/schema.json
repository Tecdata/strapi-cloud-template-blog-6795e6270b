{
  "kind": "collectionType",
  "collectionName": "ads",
  "info": {
    "singularName": "ad",
    "pluralName": "ads",
    "displayName": "Ad"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "placementKey": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "home_top_banner",
        "home_bottom_banner",
        "match_footer_banner",
        "home_feed_card"
      ]
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "priority": {
      "type": "integer",
      "required": true,
      "default": 50,
      "min": 1,
      "max": 100
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "clickUrl": {
      "type": "string"
    },
    "startAt": {
      "type": "datetime"
    },
    "endAt": {
      "type": "datetime"
    }
  }
}
